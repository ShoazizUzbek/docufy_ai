# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=docufy_ai
POSTGRES_USER=docufy_ai
POSTGRES_PASSWORD=docufy_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinIO (S3-compatible object storage)
MINIO_ACCESS_KEY=docufy_minio
MINIO_SECRET_KEY=docufy_minio_secret
MINIO_BUCKET_NAME=docufy-documents
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_USE_SSL=False

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# Document processing (Phase 2) — PaddleOCR language packs to try on
# scanned documents; best-scoring result wins. No dedicated Uzbek model,
# 'en' covers its Latin script reasonably well.
OCR_LANGUAGES=en,ru

# Search & retrieval (Phase 3)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=docufy_chunks
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# AI Gateway & RAG (Phase 4)
# AI_GATEWAY_PROVIDER: 'anthropic' (Claude API — needs AI_GATEWAY_API_KEY)
# or 'ollama' (local model via Ollama's OpenAI-compatible endpoint — no key
# needed, but Ollama must be running locally with the model pulled, e.g.
# `ollama pull qwen2.5:7b-instruct`). AI_GATEWAY_MODEL/BASE_URL left blank
# use each provider's own default — see ai_gateway/ for what those are.
AI_GATEWAY_PROVIDER=anthropic
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
