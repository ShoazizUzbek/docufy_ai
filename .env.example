# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=docufy_ai
POSTGRES_USER=docufy_ai
POSTGRES_PASSWORD=docufy_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinIO (S3-compatible object storage)
MINIO_ACCESS_KEY=docufy_minio
MINIO_SECRET_KEY=docufy_minio_secret
MINIO_BUCKET_NAME=docufy-documents
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_USE_SSL=False

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# Qdrant (vector DB) — used from Phase 3 onward
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Gateway — used from Phase 4 onward
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=
